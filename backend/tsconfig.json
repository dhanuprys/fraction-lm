{
	"compilerOptions": {
		"target": "es2022",
		"strict": true,
		"types": ["bun", "node"],
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"module": "preserve",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules"]
}
